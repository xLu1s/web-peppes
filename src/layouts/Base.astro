---
import "@fontsource-variable/bodoni-moda/opsz.css";
import "@fontsource-variable/bodoni-moda/opsz-italic.css";
import "@fontsource-variable/dm-sans/index.css";
import "@fontsource-variable/dm-sans/wght-italic.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { absolute, media, site } from "../data/site";

interface Props {
  title: string;
  description?: string;
  jsonLd?: unknown;
}

const { title, description = site.description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const image = absolute(media.fachada);
const json = jsonLd ? JSON.stringify(jsonLd) : "";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="cafetería Alcoy, cafetería Alcoi, desayunos Alcoy, terraza Alcoy, café Alameda, cañas Alcoy, Pepe's Coffee"
    />
    <meta name="geo.region" content="ES-A" />
    <meta name="geo.placename" content="Alcoi" />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta name="theme-color" content="#08090B" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content="Fachada de Pepe's Coffee & Co. en la Alameda de Alcoi" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch.png`} />
    <script is:inline>
      (function () {
        try {
          var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          var conn = navigator.connection;
          if (reduce || (conn && conn.saveData)) {
            document.documentElement.classList.add("reduce-motion");
          }
        } catch (e) {}
      })();
    </script>
    {json && <script type="application/ld+json" set:html={json} />}
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <script>
      const nodes = document.querySelectorAll("[data-reveal]");
      const reduce = document.documentElement.classList.contains("reduce-motion");
      if (reduce || !("IntersectionObserver" in window)) {
        nodes.forEach((el) => el.classList.add("is-in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-in");
              io.unobserve(entry.target);
            }
          },
          { threshold: 0.16, rootMargin: "0px 0px -8% 0px" },
        );
        nodes.forEach((el) => io.observe(el));
      }

      document.querySelectorAll(".nav-panel a").forEach((link) => {
        link.addEventListener("click", () => {
          const box = document.querySelector(".nav-check");
          if (box instanceof HTMLInputElement) box.checked = false;
        });
      });
    </script>
  </body>
</html>
