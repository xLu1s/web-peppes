---
import { asset, gallery, site } from "../data/site";
---

<section class="band" id="galeria">
  <div class="wrap">
    <p class="eyebrow" data-reveal>Galería</p>
    <h2 data-reveal>El local, en fotos.</h2>
    <p class="menu-note" data-reveal>
      Fachada, barra, terraza, desayunos y café. Lo que se ve al pasar y al sentarse. 🖤
    </p>
    <div class="mosaic">
      {
        gallery.map((photo) => (
          <figure data-reveal>
            <img
              src={asset(photo.src)}
              width={photo.width}
              height={photo.height}
              alt={photo.alt}
              loading="lazy"
            />
            <figcaption>{photo.caption}</figcaption>
          </figure>
        ))
      }
    </div>
    <p class="ig-link" data-reveal>
      <a href={site.social.instagram.url} rel="noopener noreferrer">
        Síguenos en Instagram {site.social.instagram.handle}
      </a>
    </p>
  </div>
</section>
