---
import { asset, href, maps, rating, site } from "../data/site";
---

<section class="hero-photo" id="inicio" aria-label="Pepe's Coffee & Co.">
  <img
    class="hero-bg"
    src={asset("images/terraza-desayuno.jpg")}
    width="1000"
    height="1778"
    alt="Café y tostada en la terraza de Pepe's, en la Alameda de Alcoi."
    fetchpriority="high"
  />
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="wrap hero-panel">
    <p class="eyebrow">Alcoi · l'Eixample</p>
    <h1>
      <span class="name">Pepe's</span>
      <span class="co">Coffee &amp; Co.</span>
    </h1>
    <p class="claim">Café, desayunos y cañas en la Alameda.</p>
    <p class="hero-meta">
      {site.address.street} · {rating.line}
    </p>
    <div class="cta">
      <a class="btn btn-fill" href={href("/carta")}>Ver carta</a>
      <a class="btn btn-line" href={`tel:${site.phoneTel}`}>Llamar</a>
      <a class="btn btn-line" href={maps.directions} rel="noopener noreferrer">Cómo llegar</a>
    </div>
  </div>
</section>
