---
import Base from "../layouts/Base.astro";
import CartaMenu from "../components/CartaMenu.astro";
import { menuJsonLd, site } from "../data/site";

const description =
  "Carta de Pepe's Coffee & Co. en Alcoy: cafés, desayunos, dulces, bocadillos, cañas y vinos. Sin precios publicados: pregúntanos.";
---

<Base title={`Carta | ${site.name} · Alcoy`} description={description} jsonLd={menuJsonLd()}>
  <CartaMenu />
</Base>
