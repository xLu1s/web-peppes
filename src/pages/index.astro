---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Sobre from "../components/Sobre.astro";
import CartaList from "../components/CartaList.astro";
import Galeria from "../components/Galeria.astro";
import Opiniones from "../components/Opiniones.astro";
import Ubicacion from "../components/Ubicacion.astro";
import { cafeJsonLd, site } from "../data/site";
---

<Base title={`${site.name} | Cafetería en Alcoy (Alcoi)`} jsonLd={cafeJsonLd()}>
  <Hero />
  <Sobre />
  <CartaList />
  <Galeria />
  <Ubicacion />
  <Opiniones />
</Base>
